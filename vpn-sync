#!/bin/bash
# vpn-sync — manage OpenVPN + WireGuard servers (Nyr road-warrior installs), optionally with
# IPsec/IKEv2 (hwdsl2's setup-ipsec-vpn), from this Mac.
#
# Sync and devices:
#   vpn-sync [server...]                  find each server, fix its IP in the profiles,
#                                         copy profiles to ~/Desktop/<server>-<ip>/
#                                         (OpenVPN/, WireGuard/, and IKEv2/ where installed)
#   vpn-sync --check [server...]          report what would change; touch nothing
#   vpn-sync --ip A.B.C.D <server>        use this address for the server
#   vpn-sync --add NAMES <server>         create devices (comma separated), then sync
#   vpn-sync --remove NAMES <server>      revoke/remove devices, then sync
#   vpn-sync --no-apps ...                don't update OpenVPN Connect's saved profiles
#
# Live monitoring:
#   vpn-sync status <server>              who is connected now (one snapshot)
#   vpn-sync watch <server> [--interval N]  stream a snapshot every N seconds (default 3)
#   vpn-sync ports [server...]            the ports each server listens on (VPNs and SSH; the cloud
#                                         firewall must allow them) and, for each connected device,
#                                         its VPN, the server port and its own address and port
#   vpn-sync ports set <server> openvpn <port> [tcp|udp]
#   vpn-sync ports set <server> wireguard <port>
#                                         move a VPN to another port: the server's config, firewall
#                                         rule and every profile; on Lightsail also opens the new port
#                                         and closes the old one (--no-firewall: leave that to you);
#                                         then syncs. Devices need their new profiles afterwards.
#   vpn-sync ports open <server>          allow every VPN port in the Lightsail firewall (install
#                                         does this too)
#
# Services:
#   vpn-sync service <server> <openvpn|wireguard|ipsec|all> <start|stop|restart|status>
#   vpn-sync reboot <server>              reboot the whole server
#
# Data usage and limits (counted on the server every minute; sizes like 500MB, 5GB, 1.5TB):
#   vpn-sync usage [server...]            today's and this month's usage per device, its limit,
#                                         how much of it is used, and pauses (all servers if none
#                                         given); paused devices first, then closest to a limit
#   vpn-sync usage <server> --raw         the server's report as is (USAGEAT/USAGE/LIMIT/PAUSED)
#   vpn-sync limits [server...]           only devices with a limit or a pause
#   vpn-sync limit <server> <device>      show one device's limit and usage
#   vpn-sync limit <server> <device> [--daily SIZE] [--monthly SIZE] [--action alert|pause]
#                                         set or change it (options left out keep their value)
#   vpn-sync limit <server> <device> --clear
#   vpn-sync pause <server> <device>      block its traffic (it stays connected; nothing is revoked)
#   vpn-sync resume <server> <device>     unblock it (a limit pause stays lifted until the period ends)
#
# Device locations (offline country lookup; no IP address leaves this Mac):
#   vpn-sync geo update                   download the latest IP-to-country table (ip-location-db
#                                         user-country, public domain, daily) to ~/.config/vpn-sync/geo/
#   vpn-sync geo lookup <ip>              country code for an IPv4 address
#
# Lightsail lookup (finds a server's new IP after a stop/start):
#   vpn-sync aws set                      save a read-only AWS key in the Keychain
#                                         (asks, or reads "ID<newline>SECRET" from stdin)
#   vpn-sync aws status | remove | ip <server>
#   vpn-sync aws state <server>           running, stopped, stopping or pending (and the IP)
#   vpn-sync aws stop <server>            stop the Lightsail instance (every device disconnects)
#   vpn-sync aws start <server>           start it again; add --wait to wait until it's running
#       stop/start need a key allowed lightsail:StopInstance and lightsail:StartInstance; a
#       server without a static IP comes back with a new IP (VPN Sync finds it and resyncs)
#
# Servers:
#   vpn-sync server list
#   vpn-sync server hostkey --host H [--port N] | --jump SERVER --private-ip IP
#   vpn-sync server add NAME --host H [--user U] [--key FILE.pem] [--port N]
#                           [--jump SERVER --private-ip IP] [--region R] [--hostkey-line LINE]
#   vpn-sync server edit NAME [--host H] [--user U] [--key FILE.pem] [--port N]
#                           [--jump SERVER|none] [--private-ip IP] [--region R]
#   vpn-sync server remove NAME
#   vpn-sync server rename OLD NEW        (also renames its Desktop folder)
#   vpn-sync server probe NAME            what's installed (KEY=VALUE lines)
#   vpn-sync server install NAME [--openvpn-proto tcp|udp] [--openvpn-port N]
#                           [--wireguard-port N] [--dns 1-7] [--client NAME]
#                           [--no-openvpn] [--no-wireguard] [--ipsec]
#       installs OpenVPN/WireGuard if missing (keeps existing installs), plus the
#       server tools; then syncs. --ipsec also installs IPsec/IKEv2 (IKEv2 only; UDP 500
#       and 4500) and gives every device an IKEv2 profile; once installed it's kept.
#
# Servers are found via --ip, the AWS CLI (if set up), the last known IP, the
# configured host, a jump server, then VPN tunnel addresses. Every server's SSH host
# key is pinned in ~/.config/vpn-sync/known_hosts. Written for macOS /bin/bash 3.2.
set -euo pipefail

CONFIG_DIR="${VPN_SYNC_CONFIG_DIR:-$HOME/.config/vpn-sync}"
KNOWN_HOSTS="$CONFIG_DIR/known_hosts"
KEYS_DIR="$CONFIG_DIR/keys"
BUNDLE_DIR="${VPN_SYNC_BUNDLE:-$HOME/.local/share/vpn-sync/server}"
OVPN_CONNECT_PROFILES="$HOME/Library/Application Support/OpenVPN Connect/profiles"
IPV4_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
HOST_RE='^[A-Za-z0-9.-]{1,253}$'
SERVER_RE='^[A-Za-z0-9_-]{1,40}$'
NAME_RE='^[A-Za-z0-9_-]{1,15}$'

die()  { printf 'vpn-sync: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
slug() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

STAGES=""
cleanup() { local s; for s in $STAGES; do rm -rf "$s"; done; }
trap cleanup EXIT
mkdir -p "$CONFIG_DIR" "$KEYS_DIR"; chmod 700 "$CONFIG_DIR" "$KEYS_DIR"
touch "$KNOWN_HOSTS"; chmod 600 "$KNOWN_HOSTS"

# ---------------------------------------------------------------- server config

load_server() { # sets S_* globals for server $1
	local cfg="$CONFIG_DIR/$1.conf"
	[ -f "$cfg" ] || die "no server named '$1' (see: vpn-sync server list)"
	HOST="" SSH_USER=ubuntu SSH_KEY="" SSH_PORT=22 HOST_ALIAS="" JUMP="" PRIVATE_IP=""
	TUNNEL_IPS="10.8.0.1 10.7.0.1" DEST_PARENT="$HOME/Desktop" LIGHTSAIL_REGION="" LIGHTSAIL_INSTANCE="$1"
	# shellcheck disable=SC1090
	. "$cfg"
	S_NAME="$1" S_HOST="$HOST" S_USER="$SSH_USER" S_KEY="$SSH_KEY" S_PORT="$SSH_PORT"
	S_ALIAS="${HOST_ALIAS:-$(slug "$1")}" S_JUMP="$JUMP" S_PRIVATE_IP="$PRIVATE_IP"
	S_TUNNELS="$TUNNEL_IPS" S_DEST="$DEST_PARENT" S_REGION="$LIGHTSAIL_REGION" S_INSTANCE="$LIGHTSAIL_INSTANCE"
	S_STATE="$CONFIG_DIR/$1.last-ip"
	S_LAST=""; [ -f "$S_STATE" ] && S_LAST=$(cat "$S_STATE")
	[ -n "$S_KEY" ] || die "$cfg: SSH_KEY is not set"
	[ -f "$S_KEY" ] || die "SSH key for $1 not found: $S_KEY"
	return 0
}

write_server() { # write_server NAME (uses W_* globals)
	local cfg="$CONFIG_DIR/$1.conf" tmp
	tmp=$(mktemp "$CONFIG_DIR/.$1.XXXXXX")
	{
		echo "# vpn-sync server config (edit with: vpn-sync server edit $1)"
		echo "HOST=$W_HOST"
		echo "SSH_USER=$W_USER"
		echo "SSH_KEY=\"$W_KEY\""
		echo "SSH_PORT=$W_PORT"
		echo "HOST_ALIAS=$W_ALIAS"
		[ -n "$W_JUMP" ] && echo "JUMP=$W_JUMP"
		[ -n "$W_PRIVATE_IP" ] && echo "PRIVATE_IP=$W_PRIVATE_IP"
		[ -n "$W_TUNNELS" ] && echo "TUNNEL_IPS=\"$W_TUNNELS\""
		echo "DEST_PARENT=\"$W_DEST\""
		[ -n "$W_REGION" ] && echo "LIGHTSAIL_REGION=$W_REGION"
		echo "LIGHTSAIL_INSTANCE=$W_INSTANCE"
	} > "$tmp"
	chmod 600 "$tmp"; mv "$tmp" "$cfg"
}

import_key() { # import_key SERVER FILE -> prints stored path
	local src="$1" dest="$KEYS_DIR/$2.pem"
	[ -f "$src" ] || die "key file not found: $src"
	grep -q "PRIVATE KEY" "$src" || die "$src doesn't look like a private key (.pem / OpenSSH)"
	if [ "$src" != "$dest" ]; then cp "$src" "$dest"; fi
	chmod 600 "$dest"
	ssh-keygen -y -f "$dest" >/dev/null 2>&1 || die "$src can't be read (passphrase-protected keys aren't supported)"
	printf '%s' "$dest"
}

# ---------------------------------------------------------------- ssh plumbing

# Connection sharing: the first SSH connection to a server stays open for 2 minutes (or as long as
# something uses it, like the app's live view) and later commands run over it, which saves a
# full handshake (over a second to a far server, twice through a jump server) on every command.
# The sockets live in a folder only this user can open; VPNSYNC_NO_MUX=1 turns sharing off.
mux_dir() {
	[ "${VPNSYNC_NO_MUX:-0}" = 1 ] && return 1
	# short: a socket path (this + 40 + the 17 characters ssh adds while creating it) must fit in 104
	local d="/tmp/vpnsync-$(id -u)"
	if [ ! -d "$d" ]; then mkdir -m 700 "$d" 2>/dev/null || return 1; fi
	[ -O "$d" ] && [ "$(stat -f %Lp "$d" 2>/dev/null)" = 700 ] || return 1
	printf '%s' "$d"
}
MUX_DIR=$(mux_dir || true)

base_ssh_opts() { # for the loaded server; prints nothing, sets SSH_OPTS array
	SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=7 -o IdentitiesOnly=yes -i "$S_KEY" -p "$S_PORT"
		-o HostKeyAlias="$S_ALIAS" -o UserKnownHostsFile="$KNOWN_HOSTS" -o StrictHostKeyChecking=yes
		-o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o LogLevel=ERROR)
	[ -n "$MUX_DIR" ] && SSH_OPTS+=(-o ControlMaster=auto -o ControlPath="$MUX_DIR/%C" -o ControlPersist=120)
	return 0
}

jump_proxy() { # jump_proxy JUMPSERVER -> ProxyCommand string through that server's best address
	local j="$1" addr
	( load_server "$j"
	  addr="$S_LAST"; [ -n "$addr" ] || addr="$S_HOST"
	  [ -n "$addr" ] || exit 1
	  # reuses the jump server's shared connection when there is one (never starts one: -W can't)
	  local mux=""; [ -n "$MUX_DIR" ] && mux="-o ControlMaster=no -o ControlPath=$MUX_DIR/%%C "   # %% : ProxyCommand expands % itself
	  printf 'ssh -o BatchMode=yes -o ConnectTimeout=7 -o IdentitiesOnly=yes -i %s -p %s -o HostKeyAlias=%s -o UserKnownHostsFile=%s -o StrictHostKeyChecking=yes -o LogLevel=ERROR %s-W %%h:%%p %s@%s' \
		"$S_KEY" "$S_PORT" "$S_ALIAS" "$KNOWN_HOSTS" "$mux" "$S_USER" "$addr" )
}

# ssh_run MODE ADDR CMD...   MODE: direct | jump
ssh_run() {
	local mode="$1" addr="$2"; shift 2
	base_ssh_opts
	# SSH_EXEC=1 replaces this process with ssh, so stopping vpn-sync stops the connection
	local ex=""; [ "${SSH_EXEC:-0}" = 1 ] && ex=exec
	if [ "$mode" = jump ]; then
		local proxy; proxy=$(jump_proxy "$S_JUMP") || return 255
		$ex ssh "${SSH_OPTS[@]}" -o ProxyCommand="$proxy" "$S_USER@$addr" "$@"
	else
		$ex ssh "${SSH_OPTS[@]}" "$S_USER@$addr" "$@"
	fi
}

sudo_prefix() { [ "$S_USER" = root ] && echo "" || echo "sudo -n "; }

# ---------------------------------------------------------------- Lightsail API (current IP)
# A read-only AWS key (lightsail:GetInstance) lets vpn-sync look up a server's current public
# IP after a stop/start. It lives in the login Keychain, never in files or process arguments.
KC_SERVICE="vpn-sync-lightsail"

aws_key_id() { security find-generic-password -s "$KC_SERVICE" 2>/dev/null | sed -n 's/^ *"acct"<blob>="\(.*\)"$/\1/p' || true; }
aws_secret() { security find-generic-password -s "$KC_SERVICE" -w 2>/dev/null || true; }

# lightsail_ip REGION INSTANCE -> current public IPv4 (empty on failure; reason on stderr)
lightsail_ip() {
	local region="$1" inst="$2" id secret out ip
	if command -v aws >/dev/null 2>&1 && aws configure get aws_access_key_id >/dev/null 2>&1; then
		ip=$(aws lightsail get-instance --region "$region" --instance-name "$inst" \
			--query 'instance.publicIpAddress' --output text 2>/dev/null || true)
		[[ "$ip" =~ $IPV4_RE ]] && { echo "$ip"; return 0; }
	fi
	id=$(aws_key_id); [ -n "$id" ] || return 1
	secret=$(aws_secret); [ -n "$secret" ] || return 1
	out=$(printf 'user = "%s:%s"\n' "$id" "$secret" | curl -sS -m 15 -K - \
		--aws-sigv4 "aws:amz:$region:lightsail" \
		-H "X-Amz-Target: Lightsail_20161128.GetInstance" -H "Content-Type: application/x-amz-json-1.1" \
		--data "{\"instanceName\":\"$inst\"}" "https://lightsail.$region.amazonaws.com/" 2>&1) || { echo "lightsail: $out" >&2; return 1; }
	ip=$(printf '%s' "$out" | plutil -extract instance.publicIpAddress raw -o - - 2>/dev/null || true)
	if [[ "$ip" =~ $IPV4_RE ]]; then echo "$ip"; return 0; fi
	echo "lightsail: $(printf '%s' "$out" | plutil -extract message raw -o - - 2>/dev/null || printf '%s' "$out" | head -c 200)" >&2
	return 1
}

# lightsail_call REGION ACTION JSON -> the API's JSON answer (non-zero exit and the reason on
# stderr on failure). ACTION is GetInstance, StopInstance, StartInstance, GetInstancePortStates,
# OpenInstancePublicPorts or CloseInstancePublicPorts. Uses the Keychain key, else the AWS CLI.
lightsail_call() {
	local region="$1" action="$2" body="$3" id secret out msg
	id=$(aws_key_id); secret=$(aws_secret)
	if [ -z "$id" ] || [ -z "$secret" ]; then
		if command -v aws >/dev/null 2>&1 && aws configure get aws_access_key_id >/dev/null 2>&1; then
			local inst; inst=$(printf '%s' "$body" | plutil -extract instanceName raw -o - - 2>/dev/null)
			case "$action" in
				GetInstance) aws lightsail get-instance --region "$region" --instance-name "$inst" --output json ;;
				StopInstance) aws lightsail stop-instance --region "$region" --instance-name "$inst" --output json ;;
				StartInstance) aws lightsail start-instance --region "$region" --instance-name "$inst" --output json ;;
				GetInstancePortStates) aws lightsail get-instance-port-states --region "$region" --instance-name "$inst" --output json ;;
				OpenInstancePublicPorts) aws lightsail open-instance-public-ports --region "$region" --cli-input-json "$body" --output json ;;
				CloseInstancePublicPorts) aws lightsail close-instance-public-ports --region "$region" --cli-input-json "$body" --output json ;;
			esac
			return
		fi
		echo "no Lightsail key saved (vpn-sync aws set)" >&2; return 1
	fi
	out=$(printf 'user = "%s:%s"\n' "$id" "$secret" | curl -sS -m 20 -K - \
		--aws-sigv4 "aws:amz:$region:lightsail" \
		-H "X-Amz-Target: Lightsail_20161128.$action" -H "Content-Type: application/x-amz-json-1.1" \
		--data "$body" "https://lightsail.$region.amazonaws.com/" 2>&1) || { echo "lightsail: $out" >&2; return 1; }
	msg=$(printf '%s' "$out" | plutil -extract message raw -o - - 2>/dev/null || printf '%s' "$out" | plutil -extract Message raw -o - - 2>/dev/null || true)
	local ok=0 k
	for k in operations operation instance portStates; do
		printf '%s' "$out" | plutil -extract "$k" raw -o - - >/dev/null 2>&1 && ok=1
	done
	if printf '%s' "$out" | plutil -extract __type raw -o - - >/dev/null 2>&1 || { [ -n "$msg" ] && [ $ok -eq 0 ]; }; then
		[ -n "$msg" ] || msg=$(printf '%s' "$out" | plutil -extract __type raw -o - - 2>/dev/null)
		case "$msg" in
			*"not authorized"*|*AccessDenied*)
				echo "lightsail: this key isn't allowed to call lightsail:$action. Add it to the key's IAM policy (Settings → Lightsail shows the policy)." >&2 ;;
			*) echo "lightsail: $msg" >&2 ;;
		esac
		return 1
	fi
	printf '%s' "$out"
}

aws_cmd() {
	case "${1:-}" in
		set)
			local id secret
			if [ -t 0 ]; then
				printf 'Access key ID: '; read -r id
				printf 'Secret access key: '; stty -echo; read -r secret; stty echo; echo
			else
				IFS= read -r id; IFS= read -r secret
			fi
			[[ "$id" =~ ^A[KS]IA[A-Z0-9]{12,20}$ ]] || die "that doesn't look like an AWS access key ID (AKIA…)"
			[[ "$secret" =~ ^[A-Za-z0-9/+=]{30,60}$ ]] || die "that doesn't look like an AWS secret access key"
			security delete-generic-password -s "$KC_SERVICE" >/dev/null 2>&1 || true
			# via `security -i` so the secret isn't in any process's arguments
			printf 'add-generic-password -s %s -a %s -l "VPN Sync Lightsail access" -w %s\n' "$KC_SERVICE" "$id" "$secret" \
				| security -i >/dev/null || die "couldn't save to the Keychain"
			info "saved Lightsail access key $id to the Keychain"
			;;
		status)
			local id; id=$(aws_key_id)
			if [ -n "$id" ]; then echo "KEY=$id"; else echo "KEY=none"; fi
			command -v aws >/dev/null 2>&1 && aws configure get aws_access_key_id >/dev/null 2>&1 && echo "AWS_CLI=configured"
			return 0
			;;
		remove)
			security delete-generic-password -s "$KC_SERVICE" >/dev/null 2>&1 && info "removed the Lightsail key from the Keychain" || info "no Lightsail key saved"
			;;
		ip)
			[ -n "${2:-}" ] || die "usage: vpn-sync aws ip <server>"
			load_server "$2"
			[ -n "$S_REGION" ] || die "$2 has no Lightsail region set (vpn-sync server edit $2 --region …)"
			local ip; ip=$(lightsail_ip "$S_REGION" "$S_INSTANCE") || die "lookup failed"
			echo "IP=$ip"
			;;
		state|stop|start)
			local cmd="$1" name="${2:-}" wait=0 out state ip
			[ -n "$name" ] || die "usage: vpn-sync aws $cmd <server>"
			[ "${3:-}" = --wait ] && wait=1
			load_server "$name"
			[ -n "$S_REGION" ] || die "$name isn't a Lightsail server (no region set: vpn-sync server edit $name --region …)"
			local body; body=$(printf '{"instanceName":"%s"}' "$S_INSTANCE")
			case "$cmd" in
				stop) lightsail_call "$S_REGION" StopInstance "$body" >/dev/null || die "stop failed"
					info "stopping $name (Lightsail instance $S_INSTANCE)"; echo "REQUESTED=stop" ;;
				start) lightsail_call "$S_REGION" StartInstance "$body" >/dev/null || die "start failed"
					info "starting $name (Lightsail instance $S_INSTANCE)"; echo "REQUESTED=start" ;;
			esac
			local tries=0
			while :; do
				out=$(lightsail_call "$S_REGION" GetInstance "$body") || die "couldn't read the instance's state"
				state=$(printf '%s' "$out" | plutil -extract instance.state.name raw -o - - 2>/dev/null || echo unknown)
				ip=$(printf '%s' "$out" | plutil -extract instance.publicIpAddress raw -o - - 2>/dev/null || true)
				[ $wait -eq 1 ] && [ "$cmd" = start ] && [ "$state" != running ] && [ $tries -lt 40 ] || break
				tries=$((tries + 1)); sleep 5
			done
			echo "STATE=$state"
			[[ "$ip" =~ $IPV4_RE ]] && echo "IP=$ip"
			if printf '%s' "$out" | plutil -extract instance.isStaticIp raw -o - - 2>/dev/null | grep -q true; then echo "STATIC_IP=yes"; else echo "STATIC_IP=no"; fi
			return 0
			;;
		*) die "usage: vpn-sync aws set | status | remove | ip | state | stop | start <server>" ;;
	esac
}

# ---------------------------------------------------------------- device locations
# ip-location-db "user-country": IPv4 → country of the person using the address; updated daily,
# public domain (PDDL). The newest release is downloaded and checked against its SHA-256.
GEO_BASE="https://github.com/sapics/ip-location-db/releases/download"
GEO_FILE="user-country-ipv4-num.csv"
GEO_DIR="$CONFIG_DIR/geo"

geo_cmd() {
	case "${1:-}" in
		update)
			mkdir -p "$GEO_DIR"
			local tmp; tmp=$(mktemp -d "$GEO_DIR/.dl.XXXXXX"); STAGES="$STAGES $tmp"
			info "downloading the latest IP-to-country table (ip-location-db user-country, about 8 MB)"
			curl -fsSL -m 600 -o "$tmp/table.csv" "$GEO_BASE/latest/$GEO_FILE" || die "download failed; kept the old table"
			curl -fsSL -m 60 -o "$tmp/table.sha256" "$GEO_BASE/checksum/$GEO_FILE.sha256" || die "couldn't get the checksum; kept the old table"
			local want got
			want=$(awk '{print $1; exit}' "$tmp/table.sha256")
			got=$(shasum -a 256 "$tmp/table.csv" | awk '{print $1}')
			[[ "$want" =~ ^[0-9a-f]{64}$ ]] && [ "$want" = "$got" ] || die "checksum mismatch; kept the old table"
			# every line must be "start,end,CC" with numbers and a two-letter code
			local bad rows
			bad=$(grep -cvE '^[0-9]+,[0-9]+,[A-Z]{2}$' "$tmp/table.csv" || true)
			rows=$(wc -l < "$tmp/table.csv" | tr -d ' ')
			[ "$rows" -gt 50000 ] && [ "$bad" -eq 0 ] || die "the table doesn't look right ($rows rows, $bad bad lines); kept the old one"
			if [ -s "$GEO_DIR/ipv4-num.csv" ] && cmp -s "$tmp/table.csv" "$GEO_DIR/ipv4-num.csv"; then
				info "already up to date ($rows ranges)"
			else
				mv "$tmp/table.csv" "$GEO_DIR/ipv4-num.csv"
				info "saved $rows ranges to $GEO_DIR/ipv4-num.csv"
			fi
			printf 'ip-location-db user-country (PDDL)\nsha256 %s\nchecked %s\n' "$got" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$GEO_DIR/VERSION"
			rm -f "$GEO_DIR/package.json"
			;;
		lookup)
			local ip="${2:-}"; [[ "$ip" =~ $IPV4_RE ]] || die "usage: vpn-sync geo lookup <ipv4>"
			[ -s "$GEO_DIR/ipv4-num.csv" ] || die "no table yet: run vpn-sync geo update"
			local IFS=. a b c d; read -r a b c d <<< "$ip"
			local n=$(( (a << 24) + (b << 16) + (c << 8) + d ))
			awk -F, -v n="$n" '$1 <= n && n <= $2 { print "COUNTRY=" $3; found=1; exit } END { if (!found) print "COUNTRY=" }' "$GEO_DIR/ipv4-num.csv"
			;;
		*) die "usage: vpn-sync geo update | lookup <ip>" ;;
	esac
}

# connect: sets VIA_MODE/VIA_ADDR to the first route that answers with the pinned key
connect() {
	local forced="$1" cands="" c mode addr tried="" aws_ip=""
	if [ -n "$forced" ]; then
		cands="direct:$forced"
	else
		# the last address first: the pinned host key proves it's still this server, so asking
		# Lightsail (another second) is only needed when it doesn't answer
		[ -n "$S_JUMP" ] && [ -n "$S_PRIVATE_IP" ] && cands="$cands jump:$S_PRIVATE_IP"
		[ -n "$S_LAST" ] && cands="$cands direct:$S_LAST"
		[ -n "$S_HOST" ] && cands="$cands direct:$S_HOST"
		cands="$cands lightsail"
		for c in $S_TUNNELS; do cands="$cands direct:$c"; done
	fi
	VIA_MODE="" VIA_ADDR=""
	for c in $cands; do
		if [ "$c" = lightsail ]; then
			[ -n "$S_REGION" ] && [ -z "$S_JUMP" ] || continue
			aws_ip=$(lightsail_ip "$S_REGION" "$S_INSTANCE" 2>/dev/null || true)
			[[ "$aws_ip" =~ $IPV4_RE ]] || continue
			[ "$aws_ip" != "$S_LAST" ] && [ -n "$S_LAST" ] && info "  Lightsail reports a new IP for $S_NAME: $aws_ip (was $S_LAST)"
			c="direct:$aws_ip"
		fi
		case " $tried " in *" $c "*) continue ;; esac
		tried="$tried $c"
		mode="${c%%:*}" addr="${c#*:}"
		if [ "$mode" = jump ]; then printf '  trying %-16s ' "$addr via $S_JUMP"; else printf '  trying %-16s ' "$addr"; fi
		if ssh_run "$mode" "$addr" true </dev/null 2>/dev/null; then
			info "ok"; VIA_MODE="$mode" VIA_ADDR="$addr"; return 0
		fi
		info "no answer"
	done
	return 1
}

remote() { ssh_run "$VIA_MODE" "$VIA_ADDR" "$@"; }

prefix_stream() { # prefix server output; turn ADDED=/REMOVED= markers into readable lines
	local line
	while IFS= read -r line; do
		case "$line" in
			ADDED=*)   info "  added device: ${line#ADDED=}" ;;
			REMOVED=*) info "  removed device: ${line#REMOVED=}" ;;
			*)         info "  server: $line" ;;
		esac
	done
}

# ---------------------------------------------------------------- sync

opt_ip="" opt_check=0 opt_apps=1 opt_add="" opt_remove="" opt_failed=0

add_names() { # add_names <var> <list>
	local var="$1" n list
	list=$(printf '%s' "$2" | tr ', \n' '   ')
	[ -n "${list// /}" ] || die "--add/--remove needs at least one name"
	for n in $list; do
		[[ "$n" =~ $NAME_RE ]] || die "invalid device name '$n': use 1-15 letters, digits, _ or -"
		eval "$var=\"\$$var $n\""
	done
}

sync_server() {
	load_server "$1"
	info "== $S_NAME"
	if ! connect "$opt_ip"; then
		info "  ! could not reach $S_NAME; nothing changed"
		info "    (if this Mac is connected to $S_NAME's VPN on an old address, disconnect it first)"
		return 1
	fi
	local sudo; sudo=$(sudo_prefix)
	local out
	if ! out=$(remote "${sudo}/usr/local/sbin/vpn-endpoint-sync$([ $opt_check -eq 1 ] && echo ' --dry-run')" 2>&1 </dev/null); then
		printf '%s\n' "$out" | sed 's/^/  server: /'
		info "  ! server tools aren't installed or failed (run: vpn-sync server install $S_NAME)"
		return 1
	fi
	printf '%s\n' "$out" | grep -v '^ENDPOINT=' | sed 's/^/  server: /'
	local ip; ip=$(printf '%s\n' "$out" | sed -n 's/^ENDPOINT=//p' | tail -1)
	[[ "$ip" =~ $IPV4_RE ]] || { info "  ! server did not report its IP"; return 1; }

	local dest="$S_DEST/$S_NAME-$ip" old_dir="" d
	for d in "$S_DEST/$S_NAME"-*; do
		[ -d "$d" ] && [ "$d" != "$dest" ] && [[ "${d##*/$S_NAME-}" =~ $IPV4_RE ]] && old_dir="$d"
	done
	local old_ip="${old_dir##*/$S_NAME-}"
	[ -z "$old_ip" ] && [ -n "$S_LAST" ] && [ "$S_LAST" != "$ip" ] && old_ip="$S_LAST"

	if [ $opt_check -eq 1 ]; then
		info "  current IP: $ip"
		if [ -n "$old_dir" ]; then info "  would rename $old_dir -> $dest and refresh profiles"
		elif [ -d "$dest" ]; then info "  would refresh profiles in $dest"
		else info "  would create $dest"; fi
		return 0
	fi

	if [ -n "$opt_add$opt_remove" ]; then
		local tool="vpn-add-client" names="$opt_add" verb="add"
		[ -n "$opt_remove" ] && tool="vpn-remove-client" names="$opt_remove" verb="remove"
		if ! remote "${sudo}/usr/local/sbin/$tool $names" 2>&1 </dev/null | prefix_stream; then
			info "  ! could not $verb all devices; syncing what changed"
			opt_failed=1
		fi
	fi

	local stage; stage=$(mktemp -d "${TMPDIR:-/tmp}/vpn-sync.XXXXXX"); STAGES="$STAGES $stage"
	remote "${sudo}/usr/local/sbin/vpn-export-profiles" </dev/null | tar xzf - -C "$stage" \
		|| { info "  ! could not download profiles"; return 1; }
	mkdir -p "$stage/OpenVPN" "$stage/WireGuard" "$stage/IKEv2"
	local n_ovpn n_wg n_ike
	n_ovpn=$(ls "$stage/OpenVPN" | grep -c '\.ovpn$' || true)
	n_wg=$(ls "$stage/WireGuard" | grep -c '\.conf$' || true)
	n_ike=$(ls "$stage/IKEv2" | grep -c '\.mobileconfig$' || true)

	if [ -n "$old_dir" ] && [ ! -e "$dest" ]; then
		mv "$old_dir" "$dest"; info "  renamed ${old_dir##*/} -> ${dest##*/}"
	fi
	mkdir -p "$dest"; chmod 700 "$dest"
	rm -rf "$dest/OpenVPN" "$dest/WireGuard" "$dest/IKEv2"
	mv "$stage/OpenVPN" "$stage/WireGuard" "$dest/"
	if [ "$n_ike" -gt 0 ]; then mv "$stage/IKEv2" "$dest/"; fi
	chmod 600 "$dest"/OpenVPN/* "$dest"/WireGuard/* 2>/dev/null || true
	chmod 600 "$dest"/IKEv2/* 2>/dev/null || true
	info "  profiles: $n_ovpn OpenVPN, $n_wg WireGuard$([ "$n_ike" -gt 0 ] && echo ", $n_ike IKEv2") -> $dest"

	if [ $opt_apps -eq 1 ] && [ -n "$old_ip" ] && [ "$old_ip" != "$ip" ] && [ -d "$OVPN_CONNECT_PROFILES" ]; then
		local f bdir="$CONFIG_DIR/backups/$(date +%Y%m%d-%H%M%S)" old_re="${old_ip//./\\.}"
		for f in "$OVPN_CONNECT_PROFILES"/*.ovpn; do
			[ -f "$f" ] || continue
			if grep -qE "^remote $old_re " "$f"; then
				mkdir -p "$bdir"; cp -p "$f" "$bdir/"
				sed -i '' -E "s/^remote $old_re /remote $ip /" "$f"
				info "  OpenVPN Connect: updated ${f##*/} ($old_ip -> $ip; backup in $bdir)"
			fi
		done
	fi
	if [ -n "$old_ip" ] && [ "$old_ip" != "$ip" ]; then
		info "  IP changed $old_ip -> $ip: re-import the WireGuard profiles (or edit Endpoint) on each device."
		[ "$n_ike" -gt 0 ] && info "  IKEv2 profiles were made again for $ip: install them again on each IKEv2 device."
	fi
	echo "$ip" > "$S_STATE"
	[ "$opt_failed" -eq 0 ]
}

# ---------------------------------------------------------------- server commands

server_list() {
	local f n
	for f in "$CONFIG_DIR"/*.conf; do
		[ -f "$f" ] || continue
		n=$(basename "$f" .conf)
		( load_server "$n" 2>/dev/null || true
		  printf '%s\thost=%s\tlast_ip=%s\tuser=%s\tjump=%s\n' "$n" "${S_HOST:-}" "${S_LAST:-}" "${S_USER:-}" "${S_JUMP:-}" )
	done
}

parse_server_opts() { # fills O_* from args; returns remaining positional in O_REST
	O_HOST="" O_USER="" O_KEY="" O_PORT="" O_JUMP="-" O_PRIVATE_IP="" O_REGION="" O_HOSTKEY="" O_REST=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--host) O_HOST="${2:-}"; [[ "$O_HOST" =~ $HOST_RE ]] || die "--host: not a hostname or IP"; shift ;;
			--user) O_USER="${2:-}"; [[ "$O_USER" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "--user: invalid user name"; shift ;;
			--key) O_KEY="${2:-}"; shift ;;
			--port) O_PORT="${2:-}"; [[ "$O_PORT" =~ ^[0-9]{1,5}$ ]] || die "--port: invalid"; shift ;;
			--jump) O_JUMP="${2:-}"; shift ;;
			--private-ip) O_PRIVATE_IP="${2:-}"; [[ "$O_PRIVATE_IP" =~ $IPV4_RE ]] || die "--private-ip: not an IPv4 address"; shift ;;
			--region) O_REGION="${2:-}"; [[ "$O_REGION" =~ ^[a-z0-9-]{0,30}$ ]] || die "--region: invalid"; shift ;;
			--hostkey-line) O_HOSTKEY="${2:-}"; shift ;;
			-*) die "unknown option: $1" ;;
			*) O_REST="$O_REST $1" ;;
		esac
		shift
	done
}

# hostkey_scan: prints "HOSTKEY=<type> <key>" and "FINGERPRINT=<sha256>" for --host or --jump/--private-ip
server_hostkey() {
	parse_server_opts "$@"
	local port="${O_PORT:-22}" line
	if [ "$O_JUMP" != "-" ] && [ -n "$O_JUMP" ]; then
		[ -n "$O_PRIVATE_IP" ] || die "--jump needs --private-ip"
		load_server "$O_JUMP"; connect "" >/dev/null || die "can't reach jump server $O_JUMP"
		line=$(remote "ssh-keyscan -T 8 -t ed25519 -p $port $O_PRIVATE_IP 2>/dev/null" </dev/null | grep -v '^#' | head -1)
	else
		[ -n "$O_HOST" ] || die "need --host (or --jump with --private-ip)"
		line=$(ssh-keyscan -T 8 -t ed25519 -p "$port" "$O_HOST" 2>/dev/null | grep -v '^#' | head -1)
	fi
	[ -n "$line" ] || die "no SSH host key received (is port $port open and the address right?)"
	local key="${line#* }"
	printf 'HOSTKEY=%s\n' "$key"
	printf 'FINGERPRINT=%s\n' "$(printf 'x %s\n' "$key" | ssh-keygen -lf - | awk '{print $2}')"
}

pin_hostkey() { # pin_hostkey ALIAS "type key"
	local alias="$1" key="$2" tmp
	[[ "$key" =~ ^(ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa)\ [A-Za-z0-9+/=]+$ ]] || die "malformed host key"
	tmp=$(mktemp "$CONFIG_DIR/.kh.XXXXXX")
	grep -v "^$alias " "$KNOWN_HOSTS" > "$tmp" || true
	echo "$alias $key" >> "$tmp"
	chmod 600 "$tmp"; mv "$tmp" "$KNOWN_HOSTS"
}

server_add() {
	local name="$1"; shift
	[[ "$name" =~ $SERVER_RE ]] || die "server name: use 1-40 letters, digits, _ or -"
	[ -f "$CONFIG_DIR/$name.conf" ] && die "server '$name' already exists (use: vpn-sync server edit $name)"
	parse_server_opts "$@"
	[ "$O_JUMP" = "-" ] && O_JUMP=""
	[ -n "$O_HOST$O_PRIVATE_IP" ] || die "need --host (public IP or hostname)"
	[ -z "$O_JUMP" ] || [ -n "$O_PRIVATE_IP" ] || die "--jump needs --private-ip"
	[ -z "$O_JUMP" ] || [ -f "$CONFIG_DIR/$O_JUMP.conf" ] || die "jump server '$O_JUMP' isn't configured"
	[ -n "$O_KEY" ] || die "need --key (the server's private key, e.g. the Lightsail .pem)"
	local hk="$O_HOSTKEY"
	if [ -z "$hk" ]; then
		local scan
		if [ -n "$O_JUMP" ]; then scan=$(server_hostkey --jump "$O_JUMP" --private-ip "$O_PRIVATE_IP" --port "${O_PORT:-22}")
		else scan=$(server_hostkey --host "$O_HOST" --port "${O_PORT:-22}"); fi
		hk=$(printf '%s\n' "$scan" | sed -n 's/^HOSTKEY=//p')
		info "Host key fingerprint: $(printf '%s\n' "$scan" | sed -n 's/^FINGERPRINT=//p')"
		if [ -t 0 ]; then
			printf 'Trust this server? [y/N] '; local a; read -r a
			[[ "$a" =~ ^[yY] ]] || die "not added"
		else
			die "not interactive: confirm the fingerprint and pass --hostkey-line"
		fi
	fi
	W_KEY=$(import_key "$O_KEY" "$name")
	W_HOST="$O_HOST" W_USER="${O_USER:-ubuntu}" W_PORT="${O_PORT:-22}" W_ALIAS=$(slug "$name")
	W_JUMP="$O_JUMP" W_PRIVATE_IP="$O_PRIVATE_IP" W_TUNNELS="" W_DEST="$HOME/Desktop"
	W_REGION="$O_REGION" W_INSTANCE="$name"
	pin_hostkey "$W_ALIAS" "$hk"
	write_server "$name"
	[[ "$O_HOST" =~ $IPV4_RE ]] && echo "$O_HOST" > "$CONFIG_DIR/$name.last-ip"
	info "added server $name"
	load_server "$name"
	connect "" || { info "  ! saved, but couldn't log in yet (check the user name, key and firewall)"; return 1; }
	remote "$(sudo_prefix)true" </dev/null 2>/dev/null || { info "  ! logged in, but $W_USER can't use sudo without a password"; return 1; }
	info "  login ok"
}

server_edit() {
	local name="$1"; shift
	load_server "$name"
	parse_server_opts "$@"
	W_HOST="${O_HOST:-$S_HOST}" W_USER="${O_USER:-$S_USER}" W_PORT="${O_PORT:-$S_PORT}" W_ALIAS="$S_ALIAS"
	W_JUMP="$S_JUMP"; [ "$O_JUMP" != "-" ] && W_JUMP="$O_JUMP"; [ "$W_JUMP" = none ] && W_JUMP=""
	[ -z "$W_JUMP" ] || [ -f "$CONFIG_DIR/$W_JUMP.conf" ] || die "jump server '$W_JUMP' isn't configured"
	[ "$W_JUMP" != "$name" ] || die "a server can't jump through itself"
	W_PRIVATE_IP="${O_PRIVATE_IP:-$S_PRIVATE_IP}"
	W_TUNNELS="$S_TUNNELS" W_DEST="$S_DEST" W_REGION="${O_REGION:-$S_REGION}" W_INSTANCE="$S_INSTANCE"
	W_KEY="$S_KEY"; [ -n "$O_KEY" ] && W_KEY=$(import_key "$O_KEY" "$name")
	[ -n "$O_HOSTKEY" ] && pin_hostkey "$W_ALIAS" "$O_HOSTKEY"
	write_server "$name"
	if [ -n "$O_HOST" ] && [[ "$O_HOST" =~ $IPV4_RE ]]; then echo "$O_HOST" > "$CONFIG_DIR/$name.last-ip"; fi
	info "updated server $name"
}

server_remove() {
	local name="$1"
	[ -f "$CONFIG_DIR/$name.conf" ] || die "no server named '$name'"
	local f
	for f in "$CONFIG_DIR"/*.conf; do
		[ "$f" = "$CONFIG_DIR/$name.conf" ] && continue
		grep -qx "JUMP=$name" "$f" && die "$(basename "$f" .conf) connects through $name; change that first"
	done
	load_server "$name" 2>/dev/null || true
	local alias="${S_ALIAS:-$(slug "$name")}" tmp
	tmp=$(mktemp "$CONFIG_DIR/.kh.XXXXXX"); grep -v "^$alias " "$KNOWN_HOSTS" > "$tmp" || true
	chmod 600 "$tmp"; mv "$tmp" "$KNOWN_HOSTS"
	rm -f "$CONFIG_DIR/$name.conf" "$CONFIG_DIR/$name.last-ip" "$KEYS_DIR/$name.pem"
	info "removed server $name from this Mac (the server itself and its Desktop folder are untouched)"
}

server_rename() { # server_rename OLD NEW: display name only; host key pin and Lightsail instance name stay
	local old="$1" new="$2" f d
	[ -f "$CONFIG_DIR/$old.conf" ] || die "no server named '$old'"
	[[ "$new" =~ $SERVER_RE ]] || die "new name: use 1-40 letters, digits, _ or -"
	[ "$old" != "$new" ] || die "that's already its name"
	[ ! -e "$CONFIG_DIR/$new.conf" ] || die "a server named '$new' already exists"
	load_server "$old"
	W_HOST="$S_HOST" W_USER="$S_USER" W_PORT="$S_PORT" W_ALIAS="$S_ALIAS" W_JUMP="$S_JUMP"
	W_PRIVATE_IP="$S_PRIVATE_IP" W_TUNNELS="$S_TUNNELS" W_DEST="$S_DEST" W_REGION="$S_REGION" W_INSTANCE="$S_INSTANCE"
	W_KEY="$S_KEY"
	if [ "$S_KEY" = "$KEYS_DIR/$old.pem" ]; then           # our own copy of the key follows the name
		mv "$KEYS_DIR/$old.pem" "$KEYS_DIR/$new.pem"; W_KEY="$KEYS_DIR/$new.pem"
	fi
	write_server "$new"
	[ -f "$CONFIG_DIR/$old.last-ip" ] && mv "$CONFIG_DIR/$old.last-ip" "$CONFIG_DIR/$new.last-ip"
	rm -f "$CONFIG_DIR/$old.conf"
	for f in "$CONFIG_DIR"/*.conf; do                     # servers that connect through this one
		[ -f "$f" ] && grep -qx "JUMP=$old" "$f" && sed -i '' "s/^JUMP=$old\$/JUMP=$new/" "$f" \
			&& info "  $(basename "$f" .conf) now connects through $new"
	done
	for d in "$S_DEST/$old"-*; do                         # Desktop folder <name>-<ip>
		[ -d "$d" ] && [[ "${d##*/$old-}" =~ $IPV4_RE ]] || continue
		if [ -e "$S_DEST/$new-${d##*/$old-}" ]; then info "  ! kept ${d##*/}: ${new}-${d##*/$old-} already exists"
		else mv "$d" "$S_DEST/$new-${d##*/$old-}" && info "  renamed folder ${d##*/} -> $new-${d##*/$old-}"; fi
	done
	info "renamed server $old -> $new"
}

PROBE_SCRIPT='
. /etc/os-release 2>/dev/null && echo "OS=$PRETTY_NAME"
if [ -f /etc/openvpn/server/server.conf ]; then
  echo "OPENVPN=$(awk '"'"'/^proto /{p=$2; sub("-server","",p)} /^port /{n=$2} END{print p" "n}'"'"' /etc/openvpn/server/server.conf)"
else echo "OPENVPN=none"; fi
if [ -f /etc/wireguard/wg0.conf ]; then
  echo "WIREGUARD=udp $(awk -F" = " "/^ListenPort/{print \$2}" /etc/wireguard/wg0.conf)"
else echo "WIREGUARD=none"; fi
if [ -f /etc/ipsec.d/ikev2.conf ]; then echo "IPSEC=ikev2 $(ipsec --version 2>/dev/null | awk "{print \$2; exit}")"
else echo "IPSEC=none"; fi
if [ -x /usr/local/sbin/vpn-export-profiles ] && [ -f /usr/local/lib/vpn-sync/common.sh ] && [ -f /etc/vpn-sync.conf ]; then echo "TOOLS=installed"; else echo "TOOLS=none"; fi
command -v apt-get >/dev/null && echo "PKG=apt" || { command -v dnf >/dev/null && echo "PKG=dnf" || echo "PKG=unsupported"; }
echo "PUBLIC_IP=$(curl -4 -fsS -m 6 https://checkip.amazonaws.com 2>/dev/null | tr -d "[:space:]")"
'

server_probe() {
	load_server "$1"
	connect "" >&2 || die "can't reach $1"
	local sudo; sudo=$(sudo_prefix)
	remote "${sudo}true" </dev/null 2>/dev/null || { echo "SUDO=no"; die "$S_USER can't use sudo without a password"; }
	echo "SUDO=ok"
	echo "VIA=$VIA_MODE:$VIA_ADDR"
	printf '%s' "$PROBE_SCRIPT" | remote "${sudo}bash -s"
}

server_install() {
	local name="$1"; shift
	local args="" a
	while [ $# -gt 0 ]; do
		case "$1" in
			--openvpn-proto) [[ "${2:-}" =~ ^(tcp|udp)$ ]] || die "--openvpn-proto: tcp or udp"; args="$args $1 $2"; shift ;;
			--openvpn-port|--wireguard-port) [[ "${2:-}" =~ ^[0-9]{1,5}$ ]] || die "$1: invalid port"; args="$args $1 $2"; shift ;;
			--dns) [[ "${2:-}" =~ ^[1-7]$ ]] || die "--dns: 1-7"; args="$args $1 $2"; shift ;;
			--client) [[ "${2:-}" =~ $NAME_RE ]] || die "--client: 1-15 letters, digits, _ or -"; args="$args $1 $2"; shift ;;
			--no-openvpn|--no-wireguard|--ipsec) args="$args $1" ;;
			*) die "unknown option: $1" ;;
		esac
		shift
	done
	[ -f "$BUNDLE_DIR/install.sh" ] || die "server bundle missing at $BUNDLE_DIR"
	load_server "$name"
	info "== installing on $name"
	connect "" || die "can't reach $name"
	local sudo; sudo=$(sudo_prefix)
	remote "${sudo}true" </dev/null 2>/dev/null || die "$S_USER can't use sudo without a password"
	info "  uploading tools"
	COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -czf - -C "$BUNDLE_DIR" . | remote "rm -rf /tmp/vpn-sync-bundle && mkdir -m 700 /tmp/vpn-sync-bundle && tar xzf - -C /tmp/vpn-sync-bundle" \
		|| die "upload failed"
	info "  running installer (a fresh OpenVPN or IPsec install takes a few minutes)"
	local rc=0
	remote "${sudo}bash /tmp/vpn-sync-bundle/install.sh$args; rc=\$?; rm -rf /tmp/vpn-sync-bundle; exit \$rc" </dev/null 2>&1 | prefix_stream || rc=1
	[ $rc -eq 0 ] || die "install failed on $name"
	info "  install finished"
	fw_open_all
	sync_server "$name"
}

monitor() { # monitor once|watch SERVER [--interval N]
	local mode="$1" name="${2:-}" interval=3
	[ -n "$name" ] || die "usage: vpn-sync $mode <server>"
	shift 2
	while [ $# -gt 0 ]; do
		case "$1" in
			--interval) interval="${2:-}"; [[ "$interval" =~ ^[0-9]{1,3}$ ]] && [ "$interval" -ge 1 ] || die "--interval: 1-999 seconds"; shift ;;
			*) die "unknown option: $1" ;;
		esac
		shift
	done
	load_server "$name"
	connect "" >&2 || die "can't reach $name"
	local sudo; sudo=$(sudo_prefix)
	if [ "$mode" = status ]; then
		remote "${sudo}/usr/local/sbin/vpn-status" </dev/null
	else
		echo "WATCHING	$name	$interval"
		trap - EXIT
		SSH_EXEC=1 remote "${sudo}/usr/local/sbin/vpn-status --watch $interval" </dev/null
	fi
}

# ---------------------------------------------------------------- main

service_cmd() { # service_cmd SERVER VPN ACTION | reboot SERVER
	if [ "$1" = reboot ]; then
		[ -n "${2:-}" ] || die "usage: vpn-sync reboot <server>"
		load_server "$2"; connect "" || die "can't reach $2"
		remote "$(sudo_prefix)/usr/local/sbin/vpn-service reboot" </dev/null 2>&1 | prefix_stream
		info "  $2 is rebooting; it's usually back within a minute"
		return 0
	fi
	local name="${1:-}" vpn="${2:-}" action="${3:-}"
	[ -n "$name" ] || die "usage: vpn-sync service <server> <openvpn|wireguard|ipsec|all> <start|stop|restart|status>"
	[[ "$vpn" =~ ^(openvpn|wireguard|ipsec|all)$ ]] || die "VPN must be openvpn, wireguard, ipsec or all"
	[[ "$action" =~ ^(start|stop|restart|status)$ ]] || die "action must be start, stop, restart or status"
	load_server "$name"; connect "" >&2 || die "can't reach $name"
	remote "$(sudo_prefix)/usr/local/sbin/vpn-service $vpn $action" </dev/null 2>&1
}

# ports_server SERVER: what it listens on and where each connected device comes from
ports_server() {
	local name="$1" snap
	load_server "$name"; connect "" >&2 || die "can't reach $name"
	snap=$(remote "$(sudo_prefix)/usr/local/sbin/vpn-status" </dev/null) || die "$name: couldn't read its status"
	grep -q "^PORT	" <<< "$snap" || die "$name's server tools don't report ports yet (run: vpn-sync server install $name)"
	awk -F'\t' -v wgwin=180 '
		function label(v) { return v=="openvpn" ? "OpenVPN" : v=="wireguard" ? "WireGuard" : v=="ipsec" ? "IKEv2" : v=="ssh" ? "SSH" : v }
		function addr(ip, p) { if (ip=="" || ip=="-") return "unknown"; if (index(ip, ":")) ip="[" ip "]"; return (p=="" || p=="-") ? ip : ip ":" p }
		$1=="SNAPSHOT" { now=$2 }
		$1=="PORT" { k=$2 SUBSEP toupper($3); if (!(k in pl)) { ko[++nk]=k; pv[k]=$2; pp[k]=toupper($3) } pl[k]=(k in pl) ? pl[k] ", " $4 : $4 }
		$1=="OVPN" { row[++nr]=$2 "\topenvpn\t" addr($3, $8) }
		$1=="WG" && $7>0 && now-$7 < wgwin { row[++nr]=$2 "\twireguard\t" addr($3, $8) }
		$1=="IKE" { row[++nr]=$2 "\tipsec\t" addr($3, $8) }
		END {
			for (i=1; i<=nk; i++) { k=ko[i]; t=pp[k] " " pl[k]; srv[pv[k]]=(pv[k] in srv) ? srv[pv[k]] ", " t : t }
			printf "%-10s %s\n", "LISTENS", "PORT"
			split("openvpn wireguard ipsec ssh", order, " ")
			for (i=1; i<=4; i++) if (order[i] in srv) printf "%-10s %s\n", label(order[i]), srv[order[i]]
			print ""
			if (nr == 0) { print "no devices connected"; exit }
			printf "%-16s %-10s %-14s %s\n", "DEVICE", "VPN", "SERVER PORT", "FROM"
			for (i=1; i<=nr; i++) { split(row[i], f, "\t"); printf "%-16s %-10s %-14s %s\n", f[1], label(f[2]), srv[f[2]], f[3] }
		}' <<< "$snap"
}

# fw_rule STATES_JSON PROTO PORT: how the Lightsail firewall treats that port. Prints
#   exact <portInfo JSON>    a rule for exactly this port and protocol (closing it is safe)
#   covered                  allowed by a wider rule (a range, or all protocols)
#   closed <portInfo JSON>   not allowed; the JSON opens it to the same sources as the other rules
fw_rule() {
	/usr/bin/python3 -c '
import json, sys
states = json.load(sys.stdin).get("portStates", [])
proto, port = sys.argv[1], int(sys.argv[2])
def info(r):
    d = {"fromPort": r["fromPort"], "toPort": r["toPort"], "protocol": r["protocol"]}
    for k in ("cidrs", "ipv6Cidrs"):
        if r.get(k): d[k] = r[k]
    return d
for r in states:
    if r.get("state", "open") != "open": continue
    if r["protocol"] == proto and r["fromPort"] == port == r["toPort"]:
        print("exact", json.dumps(info(r))); sys.exit()
for r in states:
    if r.get("state", "open") != "open": continue
    if r["protocol"] in (proto, "all") and r["fromPort"] <= port <= r["toPort"]:
        print("covered"); sys.exit()
v4 = any(r.get("cidrs") for r in states) or not states
v6 = any(r.get("ipv6Cidrs") for r in states)
d = {"fromPort": port, "toPort": port, "protocol": proto}
if v4: d["cidrs"] = ["0.0.0.0/0"]
if v6: d["ipv6Cidrs"] = ["::/0"]
print("closed", json.dumps(d))
' "$2" "$3" <<< "$1"
}

# fw_open_all: on Lightsail, allow every VPN port the loaded (and connected) server listens on.
# Never fails: without a key or permission it says what to open by hand.
fw_open_all() {
	local snap line vpn proto port rule states P
	[ -n "$S_REGION" ] || return 0
	snap=$(remote "$(sudo_prefix)/usr/local/sbin/vpn-status" </dev/null 2>/dev/null) || return 0
	local want; want=$(awk -F'\t' '$1=="PORT" && $2!="ssh" {print $2, $3, $4}' <<< "$snap")
	[ -n "$want" ] || return 0
	if [ -z "$(aws_key_id)" ] && ! { command -v aws >/dev/null 2>&1 && aws configure get aws_access_key_id >/dev/null 2>&1; }; then
		info "  Lightsail firewall: no key saved; allow these on the instance's Networking tab: $(awk '{printf "%s%s %s", (NR>1?", ":""), toupper($2), $3}' <<< "$want")"
		return 0
	fi
	if ! states=$(fw_states 2>&1); then
		info "  ! Lightsail firewall: ${states#lightsail: }"
		info "    allow these on the instance's Networking tab: $(awk '{printf "%s%s %s", (NR>1?", ":""), toupper($2), $3}' <<< "$want")"
		return 0
	fi
	while read -r vpn proto port; do
		P=$(echo "$proto" | tr a-z A-Z)
		rule=$(fw_rule "$states" "$proto" "$port")
		case "$rule" in
			closed*) if fw_change Open "${rule#closed }"; then info "  Lightsail firewall: opened $P $port ($(case $vpn in openvpn) echo OpenVPN;; wireguard) echo WireGuard;; *) echo IKEv2;; esac))"
				else info "  ! couldn't open $P $port in the Lightsail firewall; allow it on the instance's Networking tab"; fi ;;
			*) info "  Lightsail firewall: $P $port already allowed" ;;
		esac
	done <<< "$want"
}

fw_states() { lightsail_call "$S_REGION" GetInstancePortStates "$(printf '{"instanceName":"%s"}' "$S_INSTANCE")"; }
fw_change() { # fw_change Open|Close PORTINFO_JSON
	lightsail_call "$S_REGION" "$1InstancePublicPorts" "$(printf '{"instanceName":"%s","portInfo":%s}' "$S_INSTANCE" "$2")" >/dev/null
}

# ports_set SERVER openvpn|wireguard PORT [tcp|udp] [--no-firewall]
ports_set() {
	local name="${1:-}" vpn="${2:-}" port="${3:-}" proto="" fw=1 a
	shift 3 2>/dev/null || die "usage: vpn-sync ports set <server> openvpn <port> [tcp|udp] | wireguard <port> [--no-firewall]"
	for a in "$@"; do
		case "$a" in
			tcp|udp) proto="$a" ;;
			--no-firewall) fw=0 ;;
			*) die "unknown option: $a" ;;
		esac
	done
	[[ "$vpn" == openvpn || "$vpn" == wireguard ]] || die "which VPN: openvpn or wireguard (IKEv2 always uses UDP 500 and 4500)"
	[[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "port must be 1-65535"
	[ "$vpn" = wireguard ] && { [ -z "$proto" ] || [ "$proto" = udp ] || die "WireGuard only uses UDP"; proto=udp; }
	load_server "$name"
	connect "" >&2 || die "can't reach $name"
	local t; for t in $S_TUNNELS; do
		[ "$VIA_ADDR" = "$t" ] && die "$name is reachable only through its own VPN right now; changing a port would cut this connection"
	done
	local sudo; sudo=$(sudo_prefix)
	remote "test -x /usr/local/sbin/vpn-set-port" </dev/null || die "$name's server tools can't change ports yet (run: vpn-sync server install $name)"
	local snap old_proto old_port
	snap=$(remote "${sudo}/usr/local/sbin/vpn-status" </dev/null) || die "$name: couldn't read its status"
	old_proto="" old_port=""
	read -r old_proto old_port < <(awk -F'\t' -v v="$vpn" '$1=="PORT" && $2==v {print $3, $4; exit}' <<< "$snap") || true
	[ -n "$old_port" ] || die "$vpn isn't installed on $name"
	[ -n "$proto" ] || proto="$old_proto"
	if [ "$proto" = "$old_proto" ] && [ "$port" = "$old_port" ]; then info "$vpn on $name already uses $(echo "$proto" | tr a-z A-Z) $port"; return 0; fi
	local P; P=$(echo "$proto" | tr a-z A-Z)

	# 1. the Lightsail firewall: open the new port first (nothing changes on the server if this fails)
	local use_fw=0 states rule opened=""
	if [ $fw -eq 1 ] && [ -n "$S_REGION" ]; then
		use_fw=1
		states=$(fw_states) || die "couldn't read $name's Lightsail firewall; nothing changed (or use --no-firewall and open $P $port yourself)"
		rule=$(fw_rule "$states" "$proto" "$port")
		case "$rule" in
			closed*) fw_change Open "${rule#closed }" || die "couldn't open $P $port in $name's Lightsail firewall; nothing changed"
				opened="${rule#closed }"; info "  Lightsail firewall: opened $P $port" ;;
			*) info "  Lightsail firewall: $P $port is already allowed" ;;
		esac
	elif [ -n "$S_REGION" ]; then
		info "  Lightsail firewall left alone (--no-firewall): open $P $port on the instance's Networking tab"
	else
		info "  not a Lightsail server: allow $P $port in its provider's firewall"
	fi

	# 2. the server
	local out rc=0
	out=$(remote "${sudo}/usr/local/sbin/vpn-set-port $vpn $port $proto" </dev/null 2>&1) || rc=$?
	printf '%s\n' "$out" | grep -vE '^(PORT_OLD|PORT_NEW|PROFILES)	' | sed 's/^/  server: /'
	if [ $rc -ne 0 ]; then
		[ -n "$opened" ] && fw_change Close "$opened" && info "  Lightsail firewall: closed $P $port again"
		die "$vpn on $name wasn't changed"
	fi

	# 3. close the old port in the Lightsail firewall unless something else still uses it
	if [ $use_fw -eq 1 ]; then
		local OP; OP=$(echo "$old_proto" | tr a-z A-Z)
		snap=$(remote "${sudo}/usr/local/sbin/vpn-status" </dev/null 2>/dev/null || true)
		if awk -F'\t' -v p="$old_proto" -v n="$old_port" '$1=="PORT" && $3==p && $4==n {f=1} END {exit !f}' <<< "$snap"; then
			info "  Lightsail firewall: $OP $old_port stays open (still in use)"
		elif states=$(fw_states 2>/dev/null); then
			rule=$(fw_rule "$states" "$old_proto" "$old_port")
			case "$rule" in
				exact*) if fw_change Close "${rule#exact }"; then info "  Lightsail firewall: closed $OP $old_port"
					else info "  ! couldn't close $OP $old_port in the Lightsail firewall; close it on the instance's Networking tab"; fi ;;
				covered) info "  Lightsail firewall: $OP $old_port is part of a wider rule; left as it is" ;;
				*) ;;
			esac
		else
			info "  ! couldn't reach Lightsail to close $OP $old_port (this Mac may have been using that VPN); close it on the instance's Networking tab"
		fi
	fi
	echo "CHANGED=$vpn $proto $port"

	# 4. the new profiles to the Desktop (and OpenVPN Connect)
	info ""
	"$0" "$name" || info "  ! couldn't sync $name's profiles; run: vpn-sync $name"
	info ""
	info "Devices on $vpn need their new profile (the port is in it): scan the new QR code or import the new file."
}

ports_cmd() { # ports_cmd [server...] | set SERVER VPN PORT [PROTO] | open SERVER
	[ "${1:-}" = set ] && { shift; ports_set "$@"; return; }
	if [ "${1:-}" = open ]; then
		[ -n "${2:-}" ] || die "usage: vpn-sync ports open <server>"
		load_server "$2"; [ -n "$S_REGION" ] || die "$2 isn't a Lightsail server"
		connect "" >&2 || die "can't reach $2"
		fw_open_all; return
	fi
	local list=() f s rc=0
	for s in "$@"; do [[ "$s" =~ $SERVER_RE ]] || die "invalid server name: $s"; list+=("$s"); done
	if [ ${#list[@]} -eq 0 ]; then
		for f in "$CONFIG_DIR"/*.conf; do [ -f "$f" ] && list+=("$(basename "$f" .conf)"); done
	fi
	[ ${#list[@]} -gt 0 ] || die "no servers configured (see: vpn-sync server add)"
	for s in "${list[@]}"; do
		[ "$s" = "${list[0]}" ] || echo
		info "$s"
		( ports_server "$s" ) || rc=1
	done
	return $rc
}

SIZE_RE='^[0-9]+(\.[0-9]+)?[KMGTkmgt]?([iI]?[bB])?$'
# usage_table [only-limited] [device]: the report on stdin as a table, paused devices first,
# then closest to a limit, then most data this month. Prints nothing when no device matches.
usage_table() {
	local rows
	rows=$(awk -F'\t' -v only="${1:-0}" -v dev="${2:-}" '
		function sz(b,  u, i, t) { split("B KB MB GB TB", u, " "); i=1; while (b >= 1024 && i < 5) { b/=1024; i++ }
			if (i==1) return sprintf("%d B", b)
			t=sprintf("%.1f", b); sub(/\.0$/, "", t); return t " " u[i] }
		$1=="USAGE" { n[$2]=1; td[$2]=$3+$4; md[$2]=$5+$6 }
		$1=="LIMIT" { n[$2]=1; ld[$2]=$3; lm[$2]=$4; la[$2]=$5 }
		$1=="PAUSED" { n[$2]=1; p[$2]=$3 }
		END {
			for (d in n) {
				if (dev != "" && d != dev) continue
				if (only && !(d in ld) && !(d in p)) continue
				lim="-"; used="-"; f=0
				if (d in ld) {
					lim=""
					if (ld[d] > 0) { lim=sz(ld[d]) "/day"; f=td[d]/ld[d]; used=sprintf("%d%% of day", f*100) }
					if (lm[d] > 0) { lim=lim (lim=="" ? "" : ", ") sz(lm[d]) "/month"; g=md[d]/lm[d]
						if (g > f || used == "-") { f=g; used=sprintf("%d%% of month", g*100) } }
					lim=lim (la[d]=="pause" ? ", pause" : ", alert")
				}
				st="active"
				if (d in p) st=(p[d]=="daily") ? "paused until midnight" : (p[d]=="monthly") ? "paused until the 1st" : "paused by you"
				printf "%d\t%d\t%.0f\t%s\t%-16s %9s %9s  %-32s %-13s %s\n", (d in p) ? 0 : 1, f*1000, md[d], d,
					d, sz(td[d]), sz(md[d]), lim, used, st
			}
		}' | sort -t "$(printf '\t')" -k1,1n -k2,2nr -k3,3nr -k4,4 | cut -f5-)
	[ -n "$rows" ] || return 1
	printf '%-16s %9s %9s  %-32s %-13s %s\n' DEVICE TODAY MONTH LIMIT USED STATE
	printf '%s\n' "$rows"
}

# usage_server usage|limits|show SERVER [raw|DEVICE]: one server's table (or raw report).
usage_server() {
	local cmd="$1" name="$2" extra="${3:-}" report
	load_server "$name"; connect "" >&2 || die "can't reach $name"
	remote "test -x /usr/local/sbin/vpn-usage" </dev/null || die "$name doesn't have usage tracking yet (run: vpn-sync server install $name)"
	report=$(remote "$(sudo_prefix)/usr/local/sbin/vpn-usage report" </dev/null) || die "$name: couldn't read usage"
	case "$cmd" in
		usage) if [ "$extra" = raw ]; then printf '%s\n' "$report"; else printf '%s\n' "$report" | usage_table 0 || info "no data yet"; fi ;;
		limits) printf '%s\n' "$report" | usage_table 1 || info "no limits or pauses" ;;
		show) printf '%s\n' "$report" | usage_table 0 "$extra" || info "$extra: no data, limit or pause yet" ;;
	esac
}

SIZE_RE='^[0-9]+(\.[0-9]+)?[KMGTkmgt]?([iI]?[bB])?$'
usage_cmd() { # usage_cmd usage|limits [server...] [--raw] | limit|pause|resume SERVER DEVICE [options]
	local cmd="$1"; shift
	if [ "$cmd" = usage ] || [ "$cmd" = limits ]; then
		local raw="" list=() s f rc=0
		while [ $# -gt 0 ]; do
			case "$1" in
				--raw) [ "$cmd" = usage ] || die "--raw works with usage"; raw=raw ;;
				-*) die "unknown option: $1" ;;
				*) [[ "$1" =~ $SERVER_RE ]] || die "invalid server name: $1"; list+=("$1") ;;
			esac
			shift
		done
		if [ ${#list[@]} -eq 0 ]; then
			for f in "$CONFIG_DIR"/*.conf; do [ -f "$f" ] && list+=("$(basename "$f" .conf)"); done
		fi
		[ ${#list[@]} -gt 0 ] || die "no servers configured (see: vpn-sync server add)"
		[ -z "$raw" ] || [ ${#list[@]} -eq 1 ] || die "--raw needs exactly one server name"
		for s in "${list[@]}"; do
			if [ ${#list[@]} -gt 1 ]; then [ "$s" = "${list[0]}" ] || echo; info "$s"; fi
			( usage_server "$cmd" "$s" "$raw" ) || rc=1
		done
		return $rc
	fi
	local name="${1:-}" dev="${2:-}" args=""
	[ -n "$name" ] && [ -n "$dev" ] || die "usage: vpn-sync $cmd <server> <device>"
	[[ "$dev" =~ $NAME_RE ]] || die "device name: letters, digits, - and _ (max 15)"
	args="$dev"
	if [ "$cmd" = limit ]; then
		shift 2
		if [ $# -eq 0 ]; then usage_server show "$name" "$dev"; return; fi
		while [ $# -gt 0 ]; do
			case "$1" in
				--clear) args="$args --clear" ;;
				--daily|--monthly) [[ "${2:-}" =~ $SIZE_RE ]] || die "$1: a size like 500MB or 5GB (0 = none)"; args="$args $1 $2"; shift ;;
				--action) [[ "${2:-}" =~ ^(alert|pause)$ ]] || die "--action: alert or pause"; args="$args --action $2"; shift ;;
				*) die "unknown option: $1" ;;
			esac
			shift
		done
	fi
	load_server "$name"; connect "" >&2 || die "can't reach $name"
	local sudo out; sudo=$(sudo_prefix)
	remote "test -x /usr/local/sbin/vpn-usage" </dev/null || die "$name doesn't have usage tracking yet (run: vpn-sync server install $name)"
	if [ "$cmd" = limit ] && [[ "$args" != *--clear* ]]; then # days follow this Mac's time zone
		local tz; tz=$(readlink /etc/localtime 2>/dev/null | sed -n 's#.*/zoneinfo/##p')
		[[ "$tz" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] && args="$args --tz $tz"
	fi
	out=$(remote "${sudo}/usr/local/sbin/vpn-usage $cmd $args" </dev/null 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
	# "limit for tv: daily 1073741824, monthly 0, action pause" -> "tv: 1 GB a day, pauses at 100%"
	printf '%s\n' "$out" | awk '
		function sz(b,  u, i, t) { split("B KB MB GB TB", u, " "); i=1; while (b >= 1024 && i < 5) { b/=1024; i++ }
			if (i==1) return sprintf("%d B", b)
			t=sprintf("%.1f", b); sub(/\.0$/, "", t); return t " " u[i] }
		/^limit for [^:]+: daily [0-9]+, monthly [0-9]+, action (alert|pause)$/ {
			name=$3; sub(/:$/, "", name); d=$5; sub(/,$/, "", d); m=$7; sub(/,$/, "", m)
			l=""; if (d > 0) l=sz(d) " a day"; if (m > 0) l=l (l=="" ? "" : " and ") sz(m) " a month"
			print name ": " l ", " ($9=="pause" ? "pauses at 100%" : "alerts only"); next }
		{ print }'
	# where the device stands now
	remote "${sudo}/usr/local/sbin/vpn-usage report" </dev/null | usage_table 0 "$dev" || true
}

case "${1:-}" in
	status|watch) monitor "$@"; exit ;;
	ports) shift; ports_cmd "$@"; exit ;;
	usage|limits|limit|pause|resume) usage_cmd "$@"; exit ;;
	service) shift; service_cmd "$@"; exit ;;
	aws) shift; aws_cmd "$@"; exit ;;
	geo) shift; geo_cmd "$@"; exit ;;
	reboot) service_cmd "$@"; exit ;;
esac

if [ "${1:-}" = server ]; then
	shift
	sub="${1:-}"; shift || true
	case "$sub" in
		list) server_list ;;
		hostkey) server_hostkey "$@" ;;
		add) [ $# -ge 1 ] || die "usage: vpn-sync server add NAME --host H --key FILE"; server_add "$@" ;;
		edit) [ $# -ge 1 ] || die "usage: vpn-sync server edit NAME [options]"; server_edit "$@" ;;
		remove) [ $# -eq 1 ] || die "usage: vpn-sync server remove NAME"; server_remove "$1" ;;
		rename) [ $# -eq 2 ] || die "usage: vpn-sync server rename OLD NEW"; server_rename "$1" "$2" ;;
		probe) [ $# -eq 1 ] || die "usage: vpn-sync server probe NAME"; server_probe "$1" ;;
		install) [ $# -ge 1 ] || die "usage: vpn-sync server install NAME [options]"; server_install "$@" ;;
		*) die "unknown server command '$sub' (list, hostkey, add, edit, remove, rename, probe, install)" ;;
	esac
	exit
fi

servers=()
while [ $# -gt 0 ]; do
	case "$1" in
		--ip) opt_ip="${2:-}"; [[ "$opt_ip" =~ $IPV4_RE ]] || die "--ip needs an IPv4 address"; shift ;;
		--check|--dry-run) opt_check=1 ;;
		--no-apps) opt_apps=0 ;;
		--add) add_names opt_add "${2:-}"; shift ;;
		--remove) add_names opt_remove "${2:-}"; shift ;;
		-h|--help) awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"; exit 0 ;;
		-*) die "unknown option: $1 (see --help)" ;;
		*) servers+=("$1") ;;
	esac
	shift
done
if [ ${#servers[@]} -eq 0 ]; then
	for f in "$CONFIG_DIR"/*.conf; do [ -f "$f" ] && servers+=("$(basename "$f" .conf)"); done
	[ ${#servers[@]} -gt 0 ] || die "no servers configured (see: vpn-sync server add)"
fi
if [ ${#servers[@]} -gt 1 ]; then
	[ -n "$opt_ip" ] && die "--ip needs exactly one server name"
	[ -n "$opt_add$opt_remove" ] && die "--add/--remove need exactly one server name"
fi
if [ -n "$opt_add$opt_remove" ]; then
	[ $opt_check -eq 1 ] && die "--add/--remove can't be combined with --check"
	[ -n "$opt_add" ] && [ -n "$opt_remove" ] && die "use --add and --remove in separate runs"
fi
rc=0
for s in "${servers[@]}"; do sync_server "$s" || rc=1; done
exit $rc
