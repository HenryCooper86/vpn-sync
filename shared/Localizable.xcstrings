    "Pause its internet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停它的网络"
          }
        }
      }
    },
    "Paused": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        }
      }
    },
    "Paused by you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被你暂停"
          }
        }
      }
    },
    "Paused: daily limit reached. Back at midnight.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停：达到每日限额，午夜恢复。"
          }
        }
      }
    },
    "Paused: monthly limit reached. Back on the 1st.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停：达到每月限额，下月 1 日恢复。"
          }
        }
      }
    },
    "Pausing %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在暂停 %@…"
          }
        }
      }
