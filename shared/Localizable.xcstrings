        }
      }
    },
    "%@ is rebooting. Live monitoring reconnects when it's back.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在重启。恢复后实时监控会自动重新连接。"
