            "value": "口令"
          }
        }
      }
    },
    "Pause Internet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停网络"
          }
        }
      }
    },
    "Pause failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停失败：%@"
          }
        }
