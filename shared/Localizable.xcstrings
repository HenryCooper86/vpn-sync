            "state": "translated",
            "value": "浅色"
          }
        }
      }
    },
    "Lightsail": {},
    "Lightsail didn't give a reachable address; the server may be stopped. VPN Sync keeps trying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightsail 没有给出可连接的地址，服务器可能已停止。VPN Sync 会继续尝试。"
          }
        }
      }
    },
    "Lightsail region": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightsail 区域"
          }
        }
      }
