    },
    "Address: an IP address or hostname.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址：IP 地址或主机名。"
          }
        }
      }
    },
    "After setup, VPN Sync moves the VPN to the new port and updates every profile and the Lightsail firewall. Devices on it need their new profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置完成后，VPN Sync 会把 VPN 迁移到新端口，并更新所有配置文件和 Lightsail 防火墙。使用它的设备需要新的配置文件。"
          }
        }
      }
    },
    "After setup, VPN Sync moves the VPN to the new port and updates every profile. Devices on it need their new profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置完成后，VPN Sync 会把 VPN 迁移到新端口，并更新所有配置文件。使用它的设备需要新的配置文件。"
          }
        }
      }
    },
    "AirDrop…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔空投送…"
          }
        }
      }
    },
    "Alert only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提醒"
          }
        }
      }
    },
    "Alerts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒"
          }
        }
      }
    },
    "Alerts appear on your Mac. A paused device stays connected but gets no internet until midnight (daily) or the 1st (monthly); you can resume it early.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒会显示在你的 Mac 上。暂停的设备保持连接，但在午夜（每日）或下月 1 日（每月）之前无法上网；你可以提前恢复。"
          }
        }
      }
    },
    "All devices on %@, last 15 minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的所有设备，最近 15 分钟"
          }
        }
      }
    },
    "All network traffic of %@ (%@), counted by vnstat: in %@, out %@ this month": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All network traffic of %1$@ (%2$@), counted by vnstat: in %3$@, out %4$@ this month"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）的全部网络流量，由 vnstat 统计：本月入站 %3$@，出站 %4$@"
          }
        }
      }
    },
    "All network traffic of the server per day, counted by vnstat": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器每天的全部网络流量，由 vnstat 统计"
          }
        }
      }
    },
    "Allow the new port in your provider's firewall before you change it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改之前，请先在服务商的防火墙中放行新端口。"
          }
        }
      }
    },
    "Also install IPsec/IKEv2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时安装 IPsec/IKEv2"
          }
