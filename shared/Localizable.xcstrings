            "value": "用 VPN Sync 打开它，并输入 Mac 上显示的口令。"
          }
        }
      }
    },
    "Open ~/Desktop/%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 ~/Desktop/%@"
          }
        }
      }
    },
    "OpenVPN": {},
    "OpenVPN (UDP) and WireGuard can't share a UDP port.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN（UDP）和 WireGuard 不能共用一个 UDP 端口。"
          }
        }
      }
    },
    "OpenVPN and WireGuard can't both use UDP %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 和 WireGuard 不能同时使用 UDP %@。"
          }
        }
      }
    },
    "OpenVPN port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 端口"
          }
        }
      }
    },
    "OpenVPN port must be 1–65535.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 端口必须在 1–65535 之间。"
          }
        }
      }
    },
    "Opens VPN Sync in the Settings app, where you can choose English or Simplified Chinese.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”应用中打开 VPN Sync，可以在那里选择 English 或简体中文。"
          }
        }
      }
    },
    "Optional, e.g. ap-northeast-1. Adds a console link when the server can't be reached.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选，例如 ap-northeast-1。服务器无法连接时会附上控制台链接。"
          }
        }
      }
    },
    "Or generate names": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者自动生成名称"
          }
        }
      }
