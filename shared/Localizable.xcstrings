            "value": "同时在线最多"
          }
        }
      }
    },
    "Moves a VPN on %@ to another port: its settings, its firewall rule on the server and every device's profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
