    "How limits work": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限额如何生效"
          }
        }
      }
    },
    "How to create the key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
