          "stringUnit": {
            "state": "translated",
            "value": "将会安装"
          }
        }
      }
    },
    "won't be paused again this month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月不会再被暂停"
          }
        }
