          }
        }
      }
    },
    "Deletes its settings, the copy of its key and its pinned host key on this Mac. The server keeps running, its devices keep working, and its Desktop folder is kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除它在这台 Mac 上的设置、密钥副本和固定的主机密钥。服务器继续运行，设备照常工作，桌面文件夹也会保留。"
          }
