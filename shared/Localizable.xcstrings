    "%@ is stopping. Every device is disconnected until you start it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在停止。在你重新启动它之前，所有设备都会断开。"
