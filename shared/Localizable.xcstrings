            "value": "置顶"
          }
        }
      }
    },
    "Pin to the top": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶"
          }
        }
      }
    },
    "Pinned": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已置顶"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口"
          }
        }
      }
    },
    "Port 443 looks like ordinary web traffic, so it's the hardest for a national firewall to block. Moving away from it can make the VPN easier to block.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "443 端口看起来像普通网页流量，所以最难被国家级防火墙封锁。换掉它可能让 VPN 更容易被封锁。"
          }
        }
      }
    },
    "Ports": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口"
          }
        }
      }
    },
    "Ports %@ listens on; its firewall must allow them. Each device line shows the device's own address and port.": {
      "localizations": {
