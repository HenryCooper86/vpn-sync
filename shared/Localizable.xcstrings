    },
    "“%@” is not an IPv4 address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 IPv4 地址"
          }
        }
      }
    },
    "“%@”: use only letters, numbers, - and _.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”：只能使用字母、数字、- 和 _。"
          }
        }
      }
    },
    "“From” is the device's own address and port as the server sees it; behind a router or mobile network that's the router's.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“来自”是服务器看到的设备自己的地址和端口；如果设备在路由器或移动网络后面，那就是路由器的地址。"
          }
        }
      }
    },
    "↓ %@   ↑ %@": {
