    "Last 15 minutes. Download (blue, above) peak %@; upload (orange, below) peak %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Last 15 minutes. Download (blue, above) peak %1$@; upload (orange, below) peak %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 15 分钟。下载（蓝色，上方）峰值 %1$@；上传（橙色，下方）峰值 %2$@。"
          }
        }
      }
    },
