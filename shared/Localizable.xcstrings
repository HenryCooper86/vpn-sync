          }
        }
      }
    },
    "Use when SSH is closed to the internet but this server shares a private network with another one (e.g. Lightsail servers in the same region).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 SSH 不对互联网开放，但这台服务器与另一台共享私有网络时使用（例如同一区域的 Lightsail 服务器）。"
          }
        }
      }
    },
    "VPN Sync": {},
    "VPN Sync is locked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Sync 已锁定"
          }
        }
      }
    },
    "VPN Sync opens the new port in the Lightsail firewall first and closes the old one afterwards. The Lightsail key needs the port permissions (Settings → Lightsail shows the policy).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN Sync 会先在 Lightsail 防火墙中开放新端口，之后再关闭旧端口。Lightsail 密钥需要端口权限（“设置 → Lightsail”中有策略）。"
          }
        }
      }
    },
