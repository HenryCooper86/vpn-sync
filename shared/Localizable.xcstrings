    "Now %@ (was %@). Profiles on the Desktop are updated; re-import them on phones and TVs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Now %1$@ (was %2$@). Profiles on the Desktop are updated; re-import them on phones and TVs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
