    "First device name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一台设备的名称"
          }
        }
      }
    },
    "First device name: 1–15 letters, numbers, - or _.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一台设备的名称：1–15 个字母、数字、- 或 _。"
          }
        }
      }
    },
    "Flags show which country each device connects from. The lookup uses a local table (ip-location-db, public domain, updated daily upstream), so no address is sent anywhere. VPN Sync fetches a fresh copy automatically every month.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国旗显示每台设备从哪个国家连接。查找使用本地数据表（ip-location-db，公共领域，上游每天更新），不会把任何地址发送出去。VPN Sync 每月自动获取一份新数据。"
          }
        }
      }
    },
    "From %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@"
          }
        }
