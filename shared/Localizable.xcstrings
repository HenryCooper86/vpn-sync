    "%@ used this month on %@. Its internet is paused until the 1st; you can resume it in VPN Sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ used this month on %2$@. Its internet is paused until the 1st; you can resume it in VPN Sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上本月已用 %1$@。它的网络已暂停到下月 1 日；你可以在 VPN Sync 中恢复。"
          }
        }
      }
    },
    "%@ used today on %@. Its internet is paused until midnight; you can resume it in VPN Sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ used today on %2$@. Its internet is paused until midnight; you can resume it in VPN Sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上今天已用 %1$@。它的网络已暂停到午夜；你可以在 VPN Sync 中恢复。"
          }
        }
      }
    },
    "%@ used today, %@ this month on %@. Counted on the server every minute, in both directions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ used today, %2$@ this month on %3$@. Counted on the server every minute, in both directions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ 上今天已用 %1$@，本月 %2$@。由服务器每分钟统计，包括上下行。"
          }
        }
      }
    },
    "%@ will stop working right away on both OpenVPN and WireGuard. Revoking the OpenVPN certificate can't be undone; the profile files are kept in a backup on the server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会立即在 OpenVPN 和 WireGuard 上停止工作。吊销 OpenVPN 证书无法撤销；配置文件会备份保存在服务器上。"
          }
        }
      }
    },
    "%@'s server tools are older than this app. On the Mac, open Set Up… for %@ to update them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@'s server tools are older than this app. On the Mac, open Set Up… for %2$@ to update them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上的服务器工具比这个应用旧。请在 Mac 上为 %2$@ 打开“配置…”来更新。"
          }
        }
