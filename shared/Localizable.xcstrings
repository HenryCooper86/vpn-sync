        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢复。"
          }
        }
      }
    },
    "%@ is back. If its IP changed, the profiles on the Desktop are updated; phones and TVs need them again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢复。如果它的 IP 变了，桌面上的配置文件会更新；手机和电视需要重新导入。"
          }
        }
      }
    },
    "%@ is listed twice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 重复了。"
          }
        }
      }
    },
    "%@ is paused: connected, but no internet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暂停：保持连接，但无法上网。"
          }
        }
      }
    },
    "%@ is paused: it stays connected but gets no internet until you resume it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已暂停：它保持连接，但在你恢复之前无法上网。"
          }
        }
      }
    },
    "%@ is ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已就绪。"
          }
        }
      }
    },
    "%@ is rebooting. It's usually back within a minute.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在重启，通常一分钟内恢复。"
