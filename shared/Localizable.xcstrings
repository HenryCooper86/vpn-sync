          }
        }
      }
    },
    "Phone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机"
          }
        }
      }
    },
    "Pick the SSH private key for this server (for Lightsail: the default key .pem you downloaded).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这台服务器选择 SSH 私钥（Lightsail：你下载的默认密钥 .pem）。"
          }
        }
      }
    },
    "Pin %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶 %@"
          }
        }
      }
    },
    "Pin to Top": {
