    "%@   %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@   %2$@"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (guessed from the name)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（根据名称推测）"
          }
        }
      }
    },
    "%@ (~10 s each)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（每台约 10 秒）"
          }
        }
      }
    },
    "%@ A paused device stays connected but gets no internet until midnight (daily) or the 1st (monthly); you can resume it early from its menu. Days follow this Mac's time zone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 暂停的设备保持连接，但在午夜（每日限额）或下月 1 日（每月限额）之前无法上网；你可以在它的菜单中提前恢复。日期按这台 Mac 的时区计算。"
          }
        }
      }
    },
    "%@ Retrying…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在重试…"
          }
        }
      }
    },
    "%@ Settings → Lightsail shows the policy the key needs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在“设置 → Lightsail”中可以看到这个密钥需要的策略。"
          }
        }
      }
    },
