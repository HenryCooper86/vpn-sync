    "z": {},
    "“%@” already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。"
          }
        }
      }
    },
    "“%@” is listed twice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”重复了。"
          }
        }
      }
    },
    "“%@” is longer than 15 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”超过了 15 个字符。"
          }
