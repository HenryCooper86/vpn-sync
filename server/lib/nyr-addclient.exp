#!/usr/bin/expect -f
# Add a client through a Nyr installer's menu (option 1).
# Usage: nyr-addclient.exp <script> <client> <dns_choice>
set script [lindex $argv 0]
set client [lindex $argv 1]
set dns    [lindex $argv 2]
set timeout 120
log_user 1
spawn bash $script
expect {
  -re {Option: $}                        { send "1\r"; exp_continue }
  -re {Name: $}                          { send "$client\r"; exp_continue }
  -re {DNS server \[1\]: $}              { send "$dns\r"; exp_continue }
  -re {invalid|already exists|Invalid}   { puts "\n!! prompt rejected an answer"; exit 2 }
  timeout                                { puts "\n!! timed out"; exit 3 }
  eof
}
lassign [wait] pid spawnid os_error status
exit $status
