#!/usr/bin/env bash
# vpn-status — who is connected right now. Prints one snapshot, or one every N seconds
# with --watch N (until the reader goes away).
#
# Snapshot format (tab separated):
#   SNAPSHOT <now>
#   OVPNTIME <epoch the OpenVPN status file was written>      (OpenVPN refreshes it every 60 s)
#   OVPN  <name> <real ip> <vpn ip> <bytes rx> <bytes tx> <connected since>
#   WG    <name> <endpoint ip|-> <vpn ip> <bytes rx> <bytes tx> <latest handshake, 0 = never>
#   EVENT <epoch> openvpn <name> connected|disconnected <ip|->   (from the OpenVPN log, instant)
#   SERVICE <openvpn|wireguard> <active|inactive|failed|missing> <active since epoch|0>
#   TOTALS <iface> <today rx> <today tx> <month rx> <month tx>   (bytes, from vnstat; every ~30 s)
#   DEVINFO <name> <platform> <app>   (what OpenVPN clients report, last 30 days; every ~5 min)
#   END
set -euo pipefail
# shellcheck source=../lib/common.sh
. "${VPN_SYNC_LIB:-/usr/local/lib/vpn-sync}/common.sh"
require_root

interval=0
[[ "${1:-}" == --watch ]] && { interval="${2:-5}"; [[ "$interval" =~ ^[0-9]+$ && $interval -ge 1 ]] || interval=5; }

OVPN_STATUS=""
for f in /run/openvpn-server/status-server.log /var/log/openvpn/openvpn-status.log /etc/openvpn/server/openvpn-status.log; do
	[[ -f "$f" ]] && { OVPN_STATUS="$f"; break; }
done

wg_names() { # pubkey<TAB>name<TAB>vpn ip, from wg0.conf comments
	[[ -f "$WG_CONF" ]] || return 0
	awk '/^# BEGIN_PEER /{n=$3} /^PublicKey/{k=$3} /^AllowedIPs/{split($3,a,","); sub("/32","",a[1]); if(n!=""){print k"\t"n"\t"a[1]; n=""}}' "$WG_CONF"
}

snapshot() {
	local now; now=$(date +%s)
	printf 'SNAPSHOT\t%s\n' "$now"
	/usr/local/sbin/vpn-service all status 2>/dev/null || true
	if [[ -n "$OVPN_STATUS" ]]; then
		awk -F, '
			$1=="TIME" {print "OVPNTIME\t"$3}
			$1=="CLIENT_LIST" && $2!="UNDEF" {ip=$3; sub(/:[0-9]+$/,"",ip); print "OVPN\t"$2"\t"ip"\t"$4"\t"$6"\t"$7"\t"$9}
		' "$OVPN_STATUS"
	fi
	if [[ -f "$WG_CONF" ]] && command -v wg >/dev/null; then
		local names; names=$(wg_names)
		wg show wg0 dump 2>/dev/null | awk -F'\t' -v names="$names" '
			BEGIN { n=split(names, L, "\n"); for(i=1;i<=n;i++){ split(L[i], f, "\t"); nm[f[1]]=f[2]; vip[f[1]]=f[3] } }
			NR>1 { ep=$3; if(ep=="(none)") ep="-"; else sub(/:[0-9]+$/,"",ep); gsub(/^\[|\]$/,"",ep)
			       name=($1 in nm)?nm[$1]:substr($1,1,8)
			       print "WG\t"name"\t"ep"\t"vip[$1]"\t"$6"\t"$7"\t"$5 }'
	fi
}

events_since() { # OpenVPN connect/disconnect lines from the journal after epoch $1
	command -v journalctl >/dev/null || return 0
	journalctl -u openvpn-server@server --since "@$1" -o short-unix --no-pager -q 2>/dev/null | awk -v since="$1" '
		{ t=$1; if (t+0 <= since+0) next; sub(/\..*/,"",t) }
		/Peer Connection Initiated/ && match($0, /\[[^]]+\] Peer Connection/) {
			n=substr($0, RSTART+1, RLENGTH-18); ip=$0; sub(/.*\]/,"",ip); sub(/:[0-9]+$/,"",ip)
			print "EVENT\t"t"\topenvpn\t"n"\tconnected\t"ip; next }
		/client-instance exiting|Inactivity timeout|Connection reset, restarting|connection-reset/ {
			for (i=2;i<=NF;i++) if ($i ~ /^[A-Za-z0-9_.-]+\/[0-9a-fA-F.:]+:[0-9]+$/) {
				split($i, p, "/"); ip=p[2]; sub(/:[0-9]+$/,"",ip)
				print "EVENT\t"t"\topenvpn\t"p[1]"\tdisconnected\t"ip; break } }'
}

totals() { # server network totals from vnstat (if installed and has data yet)
	command -v vnstat >/dev/null || return 0
	local ifc line
	ifc=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
	[[ -n "$ifc" ]] || return 0
	line=$(vnstat -i "$ifc" --oneline b 2>/dev/null) || return 0
	# 1;iface;day;rx;tx;total;rate;month;rx;tx;total;rate;…
	awk -F';' -v i="$ifc" 'NF>=11 && $1 ~ /^[0-9]+$/ {print "TOTALS\t"i"\t"$4"\t"$5"\t"$9"\t"$10}' <<< "$line"
}

devinfo() { # platform/app each OpenVPN client reported (IV_PLAT / IV_GUI_VER), newest wins
	command -v journalctl >/dev/null || return 0
	journalctl -u openvpn-server@server --since -30d -o cat --no-pager -q 2>/dev/null \
		| grep -E "peer info: IV_(PLAT|GUI_VER)=|Peer Connection Initiated" | awk '
		# "1.2.3.4:5678 peer info: IV_PLAT=ios"  or  "name/1.2.3.4:5678 peer info: IV_PLAT=ios"
		/peer info: IV_/ {
			src=$1; val=$0; sub(/.*peer info: /,"",val); split(val, kv, "=")
			if (index(src, "/")) { split(src, p, "/"); nm=p[1]; if (kv[1]=="IV_PLAT") plat[nm]=kv[2]; else app[nm]=kv[2] }
			else { if (kv[1]=="IV_PLAT") pp[src]=kv[2]; else pa[src]=kv[2] }
			next }
		# "1.2.3.4:5678 [name] Peer Connection Initiated with ..."
		/Peer Connection Initiated/ && match($0, /\[[^]]+\] Peer Connection/) {
			nm=substr($0, RSTART+1, RLENGTH-18); src=$1
			if (src in pp) plat[nm]=pp[src]
			if (src in pa) app[nm]=pa[src] }
		END { for (n in plat) print "DEVINFO\t"n"\t"plat[n]"\t"(n in app ? app[n] : "-") }'
}

if [[ $interval -eq 0 ]]; then
	snapshot; totals; devinfo; echo "END"; exit 0
fi
last=$(date +%s.%N)
n=0
while :; do
	snapshot
	now=$(date +%s.%N)
	events_since "$last"
	last=$now
	(( n % 10 == 0 )) && totals
	(( n % 100 == 0 )) && devinfo
	n=$((n + 1))
	echo "END"
	sleep "$interval"
done
