#!/usr/bin/env bash
# vpn-remove-client — remove one or more devices: revoke the OpenVPN certificate and
# remove the WireGuard peer, using the Nyr installers' own menus.
# Profile files are moved to $BACKUP_DIR/removed-<timestamp>/.
# Usage: vpn-remove-client <name> [name...]      Prints "REMOVED=<name>" per device.
# Exit codes: 0 ok, 64 bad name, 66 a name doesn't exist, 70 installer failed.
# Revoking an OpenVPN certificate can't be undone.
set -euo pipefail
# shellcheck source=../lib/common.sh
. "${VPN_SYNC_LIB:-/usr/local/lib/vpn-sync}/common.sh"
require_root
[[ $# -gt 0 ]] || { echo "usage: vpn-remove-client <name> [name...]" >&2; exit 64; }

has_ovpn()  { [[ -f "$OVPN_PKI/index.txt" ]] && tail -n +2 "$OVPN_PKI/index.txt" | grep '^V' | grep -q "/CN=$1\$"; }
has_wg()    { [[ -f "$WG_CONF" ]] && grep -qx "# BEGIN_PEER $1" "$WG_CONF"; }
has_files() { [[ -e "$OVPN_DIR/$1.ovpn" || -e "$WG_DIR/$1.conf" ]]; }

bad=0
for name in "$@"; do
	if [[ ! "$name" =~ $NAME_RE ]] && ! has_ovpn "$name" && ! has_wg "$name"; then
		echo "invalid name '$name'" >&2; bad=64; continue
	fi
	if ! has_ovpn "$name" && ! has_wg "$name" && ! has_files "$name"; then
		echo "no device named '$name'" >&2; [[ $bad -eq 0 ]] && bad=66
	fi
done
[[ $bad -eq 0 ]] || { echo "nothing was removed" >&2; exit $bad; }

ensure_backup_dir
trash="$BACKUP_DIR/removed-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$trash"; chmod 700 "$trash"
[[ -f "$WG_CONF" ]] && cp -p "$WG_CONF" "$trash/wg0.conf.before"
for name in "$@"; do
	log="$trash/$name.log"
	if has_ovpn "$name"; then
		if ! "$LIB_DIR/nyr-remove.exp" "$OVPN_DIR/openvpn-install.sh" "$name" >>"$log" 2>&1 || has_ovpn "$name"; then
			echo "OpenVPN: revoking '$name' failed (log: $log)" >&2; exit 70
		fi
		echo "OpenVPN: revoked $name"
	fi
	if has_wg "$name"; then
		if ! "$LIB_DIR/nyr-remove.exp" "$WG_DIR/wireguard-install.sh" "$name" >>"$log" 2>&1 || has_wg "$name"; then
			echo "WireGuard: removing '$name' failed (log: $log)" >&2; exit 70
		fi
		echo "WireGuard: removed $name"
	fi
	for f in "$OVPN_DIR/$name.ovpn" "$WG_DIR/$name.conf" "$WG_DIR/$name-wireguard-qr.png"; do
		[[ -e "$f" ]] && mv "$f" "$trash/"
	done
	echo "REMOVED=$name"
done
chmod -R go-rwx "$trash"
